{
  "_readme": "Run `python watcher.py --verify` once to verify enabled public boards. Workday, Oracle and Phenom enumerate reported totals up to a configurable max (default 5000, hard ceiling 20000); reaching a limit is explicitly partial and cannot close missing postings. Public HTML boards paginate verified result tables. LinkedIn guest search and community sources supplement direct feeds but cannot guarantee complete market coverage. min_interval persists across runs.",

  "interval_seconds": 45,
  "feed_flush_minutes": 90,
  "digest_hour_utc": 13,
  "healthcheck_url": "",

  "dashboard_url": "http://127.0.0.1:8787",
  "description_budget": 60,
  "description_per_board": 12,
  "facts_per_cycle": 5000,

  "profile": {
    "_note": "Default candidate profile (ranking only; collection stays broad). The dashboard's Settings page stores your private copy in jobwatch.db, which overrides these values and is never committed or exported. Keys reference config/taxonomy.json, config/companies.json types, config/locations.json cities and config/skills.json.",
    "name": "My search",
    "headline": "2027 finance recruiting · Toronto & New York",
    "graduation_year": 2027,
    "graduation_month": 5,
    "education": {"level": "undergraduate", "school": "", "program": "", "gpa": null},
    "target_roles": ["investment_banking", "private_markets.private_equity", "public_markets.asset_management", "public_markets.equity_research"],
    "target_stages": ["internship", "new_grad"],
    "target_cycles": ["summer_2027", "new_grad_2027"],
    "target_locations": ["toronto", "new_york", "chicago", "boston"],
    "target_countries": ["CA", "US"],
    "open_to_remote": true,
    "target_company_types": ["canadian_bank", "bulge_bracket", "elite_boutique", "pension_fund", "private_equity"],
    "work_authorization": {"CA": "authorized", "US": "unknown"},
    "languages": ["English"],
    "skills": ["financial_modeling", "valuation", "excel", "python", "bloomberg", "capital_iq", "accounting", "capital_markets", "statistics"],
    "alerts": {"urgent_fit": 90, "high_fit": 75, "digest_fit": 55}
  },

  "filters": {
    "_include_note": "Hybrid gate (set 2026-08-14): early-career markers (intern/new-grad/junior/co-op/20xx) PLUS a whitelist of core-technical role titles (software engineer, ML engineer, data scientist, etc.) so plainly-titled new-grad roles from the curated repos come through. Bare role words alone (engineer/developer/research/quant) are NOT included — those matched every experienced-hire posting (~72% of loud pings, the 2026-07-21 over-notification). Senior/staff/II/III variants are still caught by the exclude filter, so the core-technical titles don't re-admit senior roles. To go back to strict early-career-only, drop everything from '|software engineer' onward.",
    "include": "(intern|internship|new ?grad|newgrad|graduate|university|campus|entry.level|early.career|\\b20(26|27|28)\\b|junior|apprentice|co-?op|software engineer|software developer|software development engineer|machine learning engineer|data scientist|founding engineer|research engineer|quantitative (researcher|trader|developer))",
    "exclude": "(senior|\\bsr\\b|staff|principal|\\blead\\b|manager|director|\\bVP\\b|\\bII\\b|\\bIII\\b|\\bIV\\b|sales|recruit|marketing|account exec|solutions? (consult|architect)|customer success|support engineer|\\bHR\\b|payroll|legal|counsel|physician|nurse|technician|installer|warehouse|driver|mechanic|electrician)",
    "location": "",
    "exclude_companies": "(selby jennings|anson mccade|harnham|oliver james|hunter bond|durlston|mondrian alpha|robert half|insight global|cybercoders|jobot|actalent|aerotek|teksystems|randstad|michael page|phaidon|glocomms|\\bgqr\\b|averity|storm2|mthree|revolution technologies|motion recruitment|jefferson frank|nigel frank|franklin fitch|understanding recruitment|trilogy international|hamlyn williams|eames consulting|paragon alpha|algo capital|quant capital|barrington james|xcede|kdr talent|(recruit|staffing|talent) (group|partners|solutions|agency)|executive search)"
  },

